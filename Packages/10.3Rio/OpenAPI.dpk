  OpenAPI.Model.JsonPointer in '..\..\Source\OpenAPI.Model.JsonPointer.pas',
  OpenAPI.Model.Reference in '..\..\Source\OpenAPI.Model.Reference.pas',
  OpenAPI.Model.Schema in '..\..\Source\OpenAPI.Model.Schema.pas',
